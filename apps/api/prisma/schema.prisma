generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  folders     Folder[]
  files       File[]

  @@index([name])
}

model User {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
  ownedFolders Folder[]     @relation("FolderOwner")
  ownedFiles   File[]       @relation("FileOwner")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model Folder {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  /// Database CHECK constraint also rejects self-parenting.
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          User         @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  parent         Folder?      @relation("FolderHierarchy", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children       Folder[]     @relation("FolderHierarchy")
  files          File[]

  @@unique([organizationId, id])
  @@index([organizationId, ownerId])
  @@index([organizationId, parentId, name])
  @@index([ownerId])
}

model File {
  id             String       @id @default(cuid())
  organizationId String
  ownerId        String
  folderId       String?
  originalName   String
  storedName     String
  /// Private storage identifier, never a publicly accessible URL.
  storageKey     String
  mimeType       String
  size           BigInt
  checksum       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          User         @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  folder         Folder?      @relation(fields: [organizationId, folderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, storageKey])
  @@index([organizationId, ownerId])
  @@index([organizationId, folderId])
  @@index([organizationId, createdAt])
  @@index([ownerId])
}